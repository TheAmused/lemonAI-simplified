{
  "schema_version": "1.0.0",
  "id": "noobai-xl",
  "name": "NoobAI-XL",
  "version": "1.0.0",
  "description": "Laxhar Lab's NoobAI-XL anime SDXL family (1.0 eps, 1.0 v-pred, 1.1 eps) with very broad character and artist knowledge. Can generate explicit (NSFW) images; tag prompts with safe / sensitive / nsfw / explicit to steer it. For adults only.",
  "author": "Laxhar Dream Lab",
  "license": "Fair AI Public License 1.0-SD",
  "category": "image",
  "engine": "python_uv",
  "hardware_requirements": {
    "min_vram_gb": 8.0,
    "min_ram_gb": 16.0,
    "supported_accelerators": [
      "cuda"
    ]
  },
  "install": [
    {
      "step_type": "setup_venv",
      "python_version": "3.11"
    },
    {
      "step_type": "uv_pip_install",
      "packages": [
        "torch>=2.4.0",
        "diffusers>=0.30.0",
        "transformers>=4.45.0",
        "accelerate>=0.34.0",
        "sentencepiece",
        "protobuf",
        "fastapi",
        "uvicorn",
        "pydantic"
      ]
    },
    {
      "step_type": "hf_download",
      "repo_id": "Laxhar/noobai-XL-1.1",
      "destination": "weights/model"
    }
  ],
  "runtime": {
    "archetype": "diffusers_pipeline",
    "entrypoint": "diffusers_runner.py",
    "arguments": [],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 600
  },
  "ui": {
    "title": "NoobAI-XL",
    "description": "Anime illustrations from Danbooru tags",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "masterpiece, best quality, 1girl, solo, silver hair, lemon tree, sunlight, looking at viewer"
      },
      {
        "name": "negative_prompt",
        "label": "Negative prompt",
        "widget": "textarea",
        "placeholder": "What to avoid, e.g. blurry, low quality, text",
        "default": "worst quality, low quality, lowres, bad anatomy, bad hands, extra digits, watermark, signature"
      },
      {
        "name": "aspect_ratio",
        "label": "Aspect ratio",
        "widget": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3"
        ],
        "default": "1:1",
        "grid_cols": 2
      },
      {
        "name": "seed",
        "label": "Seed",
        "widget": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1,
        "default": 42,
        "grid_cols": 1
      },
      {
        "name": "steps",
        "label": "Inference steps",
        "widget": "slider",
        "min": 10,
        "max": 60,
        "step": 1,
        "default": 28,
        "grid_cols": 2
      },
      {
        "name": "guidance_scale",
        "label": "Guidance",
        "widget": "slider",
        "min": 1.0,
        "max": 15.0,
        "step": 0.5,
        "default": 5.5,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "image",
      "protocol": "ipc_stream"
    }
  },
  "content_rating": "adult",
  "variants": [
    {
      "id": "1-0",
      "name": "1.0 (eps)",
      "description": "NoobAI-XL 1.0 epsilon-prediction: classic baseline with wide LoRA support.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "Laxhar/noobai-XL-1.0",
          "destination": "weights/model"
        }
      ]
    },
    {
      "id": "vpred-1-0",
      "name": "1.0 (v-pred)",
      "description": "NoobAI-XL 1.0 v-prediction: deeper contrast, darker night scenes, and vibrant lighting.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "Laxhar/noobai-XL-Vpred-1.0",
          "destination": "weights/model"
        }
      ]
    },
    {
      "id": "1-1",
      "name": "1.1 (Latest)",
      "description": "NoobAI-XL 1.1 epsilon-prediction: newest release with improved anatomy, hands, and character recall.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "Laxhar/noobai-XL-1.1",
          "destination": "weights/model"
        }
      ]
    }
  ]
}
