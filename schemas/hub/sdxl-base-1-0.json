{
  "schema_version": "1.0.0",
  "id": "sdxl-base-1-0",
  "name": "Stable Diffusion XL 1.0",
  "version": "1.0.0",
  "description": "Stability AI's SDXL base model: general-purpose text-to-image at 1024 px. Half-precision weights (~7 GB); on cards with less VRAM than the model the components are offloaded to system RAM.",
  "author": "Stability AI",
  "license": "CreativeML Open RAIL++-M",
  "category": "image",
  "engine": "python_uv",
  "hardware_requirements": {
    "min_vram_gb": 8.0,
    "min_ram_gb": 16.0,
    "supported_accelerators": [
      "cuda"
    ]
  },
  "install": [
    {
      "step_type": "setup_venv",
      "python_version": "3.11"
    },
    {
      "step_type": "uv_pip_install",
      "packages": [
        "torch>=2.4.0",
        "diffusers>=0.30.0",
        "transformers>=4.45.0",
        "accelerate>=0.34.0",
        "sentencepiece",
        "protobuf",
        "fastapi",
        "uvicorn",
        "pydantic"
      ]
    },
    {
      "step_type": "hf_download",
      "repo_id": "stabilityai/stable-diffusion-xl-base-1.0",
      "destination": "weights/model"
    }
  ],
  "runtime": {
    "archetype": "diffusers_pipeline",
    "entrypoint": "diffusers_runner.py",
    "arguments": [],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 600
  },
  "ui": {
    "title": "Stable Diffusion XL",
    "description": "Text to image at 1024 px",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "A cozy reading nook with a lemon tree in a sunlit greenhouse, photorealistic, 35 mm"
      },
      {
        "name": "negative_prompt",
        "label": "Negative prompt",
        "widget": "textarea",
        "placeholder": "What to avoid, e.g. blurry, low quality, text"
      },
      {
        "name": "aspect_ratio",
        "label": "Aspect ratio",
        "widget": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3"
        ],
        "default": "1:1",
        "grid_cols": 2
      },
      {
        "name": "seed",
        "label": "Seed",
        "widget": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1,
        "default": 42,
        "grid_cols": 1
      },
      {
        "name": "steps",
        "label": "Inference steps",
        "widget": "slider",
        "min": 10,
        "max": 60,
        "step": 1,
        "default": 30,
        "grid_cols": 2
      },
      {
        "name": "guidance_scale",
        "label": "Guidance",
        "widget": "slider",
        "min": 1.0,
        "max": 15.0,
        "step": 0.5,
        "default": 7.0,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "image",
      "protocol": "ipc_stream"
    }
  }
}
