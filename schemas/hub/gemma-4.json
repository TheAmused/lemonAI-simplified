{
  "schema_version": "1.0.0",
  "id": "gemma-4",
  "name": "Gemma 4",
  "version": "1.0.0",
  "description": "Google's lightweight, state-of-the-art open models on llama.cpp supporting text, reasoning, image, and audio input. Multi-turn chat with automatic context management.",
  "author": "Google DeepMind (GGUF by Unsloth)",
  "license": "Apache-2.0",
  "category": "llm",
  "engine": "standalone_binary",
  "hardware_requirements": {
    "min_vram_gb": 6.0,
    "min_ram_gb": 8.0,
    "supported_accelerators": [
      "cuda",
      "rocm",
      "metal",
      "cpu"
    ]
  },
  "install": [
    {
      "step_type": "hf_download",
      "repo_id": "unsloth/gemma-4-E4B-it-GGUF",
      "filename": "gemma-4-E4B-it-Q4_K_M.gguf",
      "destination": "weights/model.gguf",
      "sha256": "85a896a047553e842f25297ee5b031d64ff30147d9c4af17b1e4b394cd1fab87"
    },
    {
      "step_type": "hf_download",
      "repo_id": "unsloth/gemma-4-E4B-it-GGUF",
      "filename": "mmproj-BF16.gguf",
      "destination": "weights/mmproj.gguf",
      "sha256": "ee01cba03fd9c71ea2ea722225d24a84f72e7197714367e550ef705ef8851bc6"
    }
  ],
  "runtime": {
    "archetype": "llama_cpp_server",
    "entrypoint": "llama-server",
    "arguments": [
      "--ctx-size",
      "8192",
      "--parallel",
      "1",
      "--temp",
      "1.0",
      "--top-p",
      "0.95",
      "--top-k",
      "64"
    ],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 300,
    "context_window": {
      "recommended": 8192,
      "max_supported": 131072
    },
    "output_tokens": {
      "recommended": 2048,
      "max_supported": 131072
    }
  },
  "ui": {
    "title": "Gemma 4",
    "description": "General chat, reasoning and coding",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "Explain the difference between a process and a thread in five sentences."
      },
      {
        "name": "system_prompt",
        "label": "System prompt",
        "widget": "textarea",
        "placeholder": "Optional instructions for the assistant"
      },
      {
        "name": "thinking",
        "label": "Thinking",
        "widget": "switch",
        "default": false,
        "description": "Let the model reason before it answers (slower, uses part of the output budget)"
      },
      {
        "name": "temperature",
        "label": "Temperature",
        "widget": "slider",
        "min": 0.0,
        "max": 2.0,
        "step": 0.05,
        "default": 1.0,
        "grid_cols": 2
      },
      {
        "name": "max_tokens",
        "label": "Max tokens",
        "widget": "number",
        "min": 64,
        "max": 8192,
        "step": 64,
        "default": 2048,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "markdown",
      "protocol": "ipc_stream"
    }
  },
