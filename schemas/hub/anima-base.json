{
  "schema_version": "1.0.0",
  "id": "anima-base",
  "name": "Anima Base v1.0",
  "version": "1.0.0",
  "description": "CircleStone Labs and Comfy Org's Anima: a 2B anime and illustration model (NVIDIA Cosmos transformer with a Qwen3 0.6B text encoder) that follows Danbooru tags and natural language, 512-1536 px. Safety tags (safe, sensitive, nsfw, explicit) steer the content; for adults. Non-commercial model licence (generated images may be used commercially). Needs diffusers 0.39+ (modular pipeline).",
  "author": "CircleStone Labs & Comfy Org",
  "license": "CircleStone Labs Non-Commercial License",
  "category": "image",
  "engine": "python_uv",
  "hardware_requirements": {
    "min_vram_gb": 8.0,
    "min_ram_gb": 16.0,
    "supported_accelerators": [
      "cuda"
    ]
  },
  "install": [
    {
      "step_type": "setup_venv",
      "python_version": "3.11"
    },
    {
      "step_type": "uv_pip_install",
      "packages": [
        "torch>=2.4.0",
        "diffusers>=0.39.0",
        "transformers>=4.51.0",
        "accelerate>=0.34.0",
        "sentencepiece",
        "protobuf",
        "fastapi",
        "uvicorn",
        "pydantic"
      ]
    },
    {
      "step_type": "hf_download",
      "repo_id": "circlestone-labs/Anima-Base-v1.0-Diffusers",
      "destination": "weights/model"
    }
  ],
  "runtime": {
    "archetype": "diffusers_pipeline",
    "entrypoint": "diffusers_runner.py",
    "arguments": [],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 600
  },
  "ui": {
    "title": "Anima Base v1.0",
    "description": "Anime and illustration (natural language or tags)",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "masterpiece, best quality, score_7, safe, 1girl, solo, school uniform, cherry blossoms, wind"
      },
      {
        "name": "negative_prompt",
        "label": "Negative prompt",
        "widget": "textarea",
        "placeholder": "What to avoid, e.g. blurry, low quality, text",
        "default": "worst quality, low quality, score_1, score_2, score_3"
      },
      {
        "name": "aspect_ratio",
        "label": "Aspect ratio",
        "widget": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3"
        ],
        "default": "1:1",
        "grid_cols": 2
      },
      {
        "name": "seed",
        "label": "Seed",
        "widget": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1,
        "default": 42,
        "grid_cols": 1
      },
      {
        "name": "steps",
        "label": "Inference steps",
        "widget": "slider",
        "min": 10,
        "max": 50,
        "step": 1,
        "default": 30,
        "grid_cols": 2
      },
      {
        "name": "guidance_scale",
        "label": "Guidance",
        "widget": "slider",
        "min": 1.0,
        "max": 8.0,
        "step": 0.5,
        "default": 4.5,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "image",
      "protocol": "ipc_stream"
    }
  },
  "content_rating": "adult"
}
