    "output_tokens": {
      "recommended": 2048,
      "max_supported": 131072
    }
  },
  "ui": {
    "title": "Gemma 4 Heretic",
    "description": "Uncensored chat (18+)",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "Explain the difference between a process and a thread in five sentences."
      },
      {
        "name": "system_prompt",
        "label": "System prompt",
        "widget": "textarea",
        "placeholder": "Optional instructions for the assistant"
      },
      {
        "name": "thinking",
        "label": "Thinking",
        "widget": "switch",
        "default": false,
        "description": "Let the model reason before it answers (slower, uses part of the output budget)"
      },
      {
        "name": "temperature",
        "label": "Temperature",
        "widget": "slider",
        "min": 0.0,
        "max": 2.0,
        "step": 0.05,
        "default": 1.0,
        "grid_cols": 2
      },
      {
        "name": "max_tokens",
        "label": "Max tokens",
        "widget": "number",
        "min": 64,
        "max": 8192,
        "step": 64,
        "default": 2048,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "markdown",
      "protocol": "ipc_stream"
    }
  },
