{
  "schema_version": "1.0.0",
  "id": "realvisxl",
  "name": "RealVisXL",
  "version": "1.0.0",
  "description": "SG161222's RealVisXL family (V4.0, V5.0 Lightning, V5.0): SDXL fine-tunes focused on realistic people and photography at 1024 px. On cards with less VRAM than the model the components are offloaded to system RAM.",
  "author": "SG161222",
  "license": "OpenRAIL++",
  "category": "image",
  "engine": "python_uv",
  "hardware_requirements": {
    "min_vram_gb": 8.0,
    "min_ram_gb": 16.0,
    "supported_accelerators": [
      "cuda"
    ]
  },
  "install": [
    {
      "step_type": "setup_venv",
      "python_version": "3.11"
    },
    {
      "step_type": "uv_pip_install",
      "packages": [
        "torch>=2.4.0",
        "diffusers>=0.30.0",
        "transformers>=4.45.0",
        "accelerate>=0.34.0",
        "sentencepiece",
        "protobuf",
        "fastapi",
        "uvicorn",
        "pydantic"
      ]
    },
    {
      "step_type": "hf_download",
      "repo_id": "SG161222/RealVisXL_V5.0",
      "destination": "weights/model"
    }
  ],
  "runtime": {
    "archetype": "diffusers_pipeline",
    "entrypoint": "diffusers_runner.py",
    "arguments": [],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 600
  },
  "ui": {
    "title": "RealVisXL",
    "description": "Realistic photos at 1024 px",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "A candid street photo of a woman laughing in the rain, Tokyo at night, neon reflections"
      },
      {
        "name": "negative_prompt",
        "label": "Negative prompt",
        "widget": "textarea",
        "placeholder": "What to avoid, e.g. blurry, low quality, text",
        "default": "(worst quality, low quality, illustration, 3d, 2d, painting, cartoons, sketch), open mouth"
      },
      {
        "name": "aspect_ratio",
        "label": "Aspect ratio",
        "widget": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3"
        ],
        "default": "1:1",
        "grid_cols": 2
      },
      {
        "name": "seed",
        "label": "Seed",
        "widget": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1,
        "default": 42,
        "grid_cols": 1
      },
      {
        "name": "steps",
        "label": "Inference steps",
        "widget": "slider",
        "min": 4,
        "max": 60,
        "step": 1,
        "default": 30,
        "grid_cols": 2
      },
      {
        "name": "guidance_scale",
        "label": "Guidance",
        "widget": "slider",
        "min": 1.0,
        "max": 15.0,
        "step": 0.5,
        "default": 5.0,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "image",
      "protocol": "ipc_stream"
    }
  },
  "variants": [
    {
      "id": "v4",
      "name": "V4.0",
      "description": "RealVisXL V4.0: classic natural photography look with balanced skin tones.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "SG161222/RealVisXL_V4.0",
          "destination": "weights/model"
        }
      ]
    },
    {
      "id": "v5-lightning",
      "name": "V5.0 Lightning (Fast)",
      "description": "RealVisXL V5.0 Lightning: fast 4-8 step photorealistic generation (use low Guidance 1.5-2.0).",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "SG161222/RealVisXL_V5.0_Lightning",
          "destination": "weights/model"
        }
      ]
    },
    {
      "id": "v5",
      "name": "V5.0 (Latest)",
      "description": "RealVisXL V5.0: newest full-quality release with crisp portraits, depth of field, and natural lighting.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "SG161222/RealVisXL_V5.0",
          "destination": "weights/model"
        }
      ]
    }
  ]
}
