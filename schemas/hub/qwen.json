{
  "schema_version": "1.0.0",
  "id": "qwen",
  "name": "Qwen",
  "version": "1.0.0",
  "description": "Alibaba's Qwen 3.5–3.8 chat models in GGUF: multilingual chat, reasoning and coding, and they read images too (vision projector included). Pick the size that fits your GPU.",
  "author": "Alibaba Qwen (GGUF by Unsloth)",
  "license": "Apache-2.0",
  "category": "llm",
  "engine": "standalone_binary",
  "hardware_requirements": {
    "min_vram_gb": 4.5,
    "min_ram_gb": 6.0,
    "supported_accelerators": [
      "cuda",
      "rocm",
      "metal",
      "cpu"
    ]
  },
  "install": [
    {
      "step_type": "hf_download",
      "repo_id": "unsloth/Qwen3.5-4B-GGUF",
      "filename": "Qwen3.5-4B-Q4_K_M.gguf",
      "destination": "weights/model.gguf",
      "sha256": "00fe7986ff5f6b463e62455821146049db6f9313603938a70800d1fb69ef11a4"
    },
    {
      "step_type": "hf_download",
      "repo_id": "unsloth/Qwen3.5-4B-GGUF",
      "filename": "mmproj-F16.gguf",
      "destination": "weights/mmproj.gguf",
      "sha256": "cd88edcf8d031894960bb0c9c5b9b7e1fea6ebee02b9f7ce925a00d12891f864"
    }
  ],
  "runtime": {
    "archetype": "llama_cpp_server",
    "entrypoint": "llama-server",
    "arguments": [
      "--ctx-size",
      "16384",
      "--parallel",
      "1",
      "--temp",
      "0.7",
      "--top-p",
      "0.8",
      "--top-k",
      "20"
    ],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 300,
    "context_window": {
      "recommended": 16384,
      "max_supported": 262144
    },
    "output_tokens": {
      "recommended": 4096,
      "max_supported": 262144
    }
  },
  "ui": {
    "title": "Qwen",
    "description": "Chat, reasoning and coding",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "Explain the difference between a process and a thread in five sentences."
      },
      {
        "name": "system_prompt",
        "label": "System prompt",
        "widget": "textarea",
        "placeholder": "Optional instructions for the assistant"
      },
      {
        "name": "thinking",
        "label": "Thinking",
        "widget": "switch",
        "default": false,
        "description": "Let the model reason before it answers (slower, uses part of the output budget)"
      },
      {
        "name": "temperature",
        "label": "Temperature",
        "widget": "slider",
        "min": 0.0,
        "max": 2.0,
        "step": 0.05,
        "default": 0.7,
        "grid_cols": 2
      },
      {
        "name": "max_tokens",
        "label": "Max tokens",
        "widget": "number",
        "min": 64,
        "max": 8192,
        "step": 64,
        "default": 2048,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "markdown",
      "protocol": "ipc_stream"
    }
  },
  "variants": [
    {
      "id": "3-5-0-8b",
      "name": "3.5 0.8B",
      "description": "The smallest Qwen 3.5 (0.8B): instant answers on any machine, also on the CPU. Reads text and images (Q4_K_M GGUF on llama.cpp). Layers that do not fit the free VRAM run on the CPU (slower).",
      "hardware_requirements": {
        "min_vram_gb": 2.0,
        "min_ram_gb": 4.0,
        "supported_accelerators": [
          "cuda",
          "rocm",
          "metal",
          "cpu"
        ]
      },
