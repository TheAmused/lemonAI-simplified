{
  "schema_version": "1.0.0",
  "id": "pony-diffusion-v6-xl",
  "name": "Pony Diffusion V6 XL",
  "version": "1.0.0",
  "description": "PurpleSmartAI's Pony Diffusion V6 XL: SDXL fine-tune for anime, furry and cartoon art driven by score and rating tags (rating_safe ... rating_explicit). Can generate explicit images; for adults only. On cards with less VRAM than the model the components are offloaded to system RAM.",
  "author": "PurpleSmartAI (diffusers conversion by Runware)",
  "license": "Fair AI Public License 1.0-SD (modified)",
  "category": "image",
  "engine": "python_uv",
  "hardware_requirements": {
    "min_vram_gb": 8.0,
    "min_ram_gb": 16.0,
    "supported_accelerators": [
      "cuda"
    ]
  },
  "install": [
    {
      "step_type": "setup_venv",
      "python_version": "3.11"
    },
    {
      "step_type": "uv_pip_install",
      "packages": [
        "torch>=2.4.0",
        "diffusers>=0.30.0",
        "transformers>=4.45.0",
        "accelerate>=0.34.0",
        "sentencepiece",
        "protobuf",
        "fastapi",
        "uvicorn",
        "pydantic"
      ]
    },
    {
      "step_type": "hf_download",
      "repo_id": "Runware/Pony_Diffusion_V6_XL",
      "destination": "weights/model"
    }
  ],
  "runtime": {
    "archetype": "diffusers_pipeline",
    "entrypoint": "diffusers_runner.py",
    "arguments": [],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 600
  },
  "ui": {
    "title": "Pony Diffusion V6 XL",
    "description": "Stylised characters from score tags",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "score_9, score_8_up, score_7_up, rating_safe, a cheerful fox adventurer in a lemon orchard"
      },
      {
        "name": "negative_prompt",
        "label": "Negative prompt",
        "widget": "textarea",
        "placeholder": "What to avoid, e.g. blurry, low quality, text",
        "default": "score_4, score_5, score_6, blurry, lowres, watermark"
      },
      {
        "name": "aspect_ratio",
        "label": "Aspect ratio",
        "widget": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3"
        ],
        "default": "1:1",
        "grid_cols": 2
      },
      {
        "name": "seed",
        "label": "Seed",
        "widget": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1,
        "default": 42,
        "grid_cols": 1
      },
      {
        "name": "steps",
        "label": "Inference steps",
        "widget": "slider",
        "min": 10,
        "max": 60,
        "step": 1,
        "default": 25,
        "grid_cols": 2
      },
      {
        "name": "guidance_scale",
        "label": "Guidance",
        "widget": "slider",
        "min": 1.0,
        "max": 15.0,
        "step": 0.5,
        "default": 7.0,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "image",
      "protocol": "ipc_stream"
    }
  },
  "content_rating": "adult"
}
