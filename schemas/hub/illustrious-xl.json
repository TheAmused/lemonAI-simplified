{
  "schema_version": "1.0.0",
  "id": "illustrious-xl",
  "name": "Illustrious XL",
  "version": "1.0.0",
  "description": "OnomaAI's Illustrious XL anime and illustration SDXL family (v0.1, v1.0, v2.0) trained on Danbooru tags at 1024-1536 px. Can generate explicit (NSFW) images; tag prompts with safe / sensitive / nsfw / explicit to steer it. For adults only.",
  "author": "OnomaAI Research (diffusers conversions by WhiteAiZ, Jommarn)",
  "license": "Fair AI Public License 1.0-SD",
  "category": "image",
  "engine": "python_uv",
  "hardware_requirements": {
    "min_vram_gb": 8.0,
    "min_ram_gb": 16.0,
    "supported_accelerators": [
      "cuda"
    ]
  },
  "install": [
    {
      "step_type": "setup_venv",
      "python_version": "3.11"
    },
    {
      "step_type": "uv_pip_install",
      "packages": [
        "torch>=2.4.0",
        "diffusers>=0.30.0",
        "transformers>=4.45.0",
        "accelerate>=0.34.0",
        "sentencepiece",
        "protobuf",
        "fastapi",
        "uvicorn",
        "pydantic"
      ]
    },
    {
      "step_type": "hf_download",
      "repo_id": "Jommarn/Illustrious-XL-v2.0",
      "destination": "weights/model"
    }
  ],
  "runtime": {
    "archetype": "diffusers_pipeline",
    "entrypoint": "diffusers_runner.py",
    "arguments": [],
    "transport": "loopback_http",
    "health_endpoint": "/health",
    "readiness_timeout_sec": 600
  },
  "ui": {
    "title": "Illustrious XL",
    "description": "Anime illustrations from Danbooru tags",
    "inputs": [
      {
        "name": "prompt",
        "label": "Prompt",
        "widget": "textarea",
        "required": true,
        "default": "masterpiece, best quality, 1girl, solo, silver hair, lemon tree, sunlight, looking at viewer"
      },
      {
        "name": "negative_prompt",
        "label": "Negative prompt",
        "widget": "textarea",
        "placeholder": "What to avoid, e.g. blurry, low quality, text",
        "default": "worst quality, low quality, lowres, bad anatomy, bad hands, extra digits, watermark, signature"
      },
      {
        "name": "aspect_ratio",
        "label": "Aspect ratio",
        "widget": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3"
        ],
        "default": "1:1",
        "grid_cols": 2
      },
      {
        "name": "seed",
        "label": "Seed",
        "widget": "number",
        "min": 0,
        "max": 2147483647,
        "step": 1,
        "default": 42,
        "grid_cols": 1
      },
      {
        "name": "steps",
        "label": "Inference steps",
        "widget": "slider",
        "min": 10,
        "max": 60,
        "step": 1,
        "default": 28,
        "grid_cols": 2
      },
      {
        "name": "guidance_scale",
        "label": "Guidance",
        "widget": "slider",
        "min": 1.0,
        "max": 15.0,
        "step": 0.5,
        "default": 6.0,
        "grid_cols": 1
      }
    ],
    "output": {
      "type": "image",
      "protocol": "ipc_stream"
    }
  },
  "content_rating": "adult",
  "variants": [
    {
      "id": "v0-1",
      "name": "v0.1",
      "description": "Illustrious XL v0.1: the original base checkpoint with broad community LoRA compatibility.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "OnomaAIResearch/Illustrious-xl-early-release-v0",
          "destination": "weights/model"
        }
      ]
    },
    {
      "id": "v1-0",
      "name": "v1.0",
      "description": "Illustrious XL v1.0: upgraded anime composition, lighting, and anatomy over v0.1.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "WhiteAiZ/Illustrious-xl-v1.0",
          "destination": "weights/model"
        }
      ]
    },
    {
      "id": "v2",
      "name": "v2.0 (Latest)",
      "description": "Illustrious XL v2.0: newest base release with native 1536 px support and stronger natural-language prompts.",
      "install": [
        {
          "step_type": "setup_venv",
          "python_version": "3.11"
        },
        {
          "step_type": "uv_pip_install",
          "packages": [
            "torch>=2.4.0",
            "diffusers>=0.30.0",
            "transformers>=4.45.0",
            "accelerate>=0.34.0",
            "sentencepiece",
            "protobuf",
            "fastapi",
            "uvicorn",
            "pydantic"
          ]
        },
        {
          "step_type": "hf_download",
          "repo_id": "Jommarn/Illustrious-XL-v2.0",
          "destination": "weights/model"
        }
      ]
    }
  ]
}
