# Copy to .env and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (use only URL-safe characters, token_urlsafe output is fine: it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=

# Optional: create the first administrator on start-up (password: 12+ characters).
# Admins decide which models are "curated" (PUT /api/scripts/<slug>/curation).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allows the Vite React UI (http://localhost:1420) and Tauri origins to call the Docker API
CORS_ORIGINS=http://tauri.localhost,tauri://localhost,http://localhost:1420
# API_BIND=127.0.0.1
